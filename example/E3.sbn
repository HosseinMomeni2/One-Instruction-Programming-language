### Example 3: function calling
## This will call the foo and then jumps back to main
sbn, 0, 1, r0, start

L foo
out "this is foo"
out "jumping to main"
sbn, 0, 1, r0, r15


L start
out "started"
out "linking r15"
link r15
sbn, r15, -4, r15, +1
out "jumping to foo"
sbn, 0, 1, r0, foo
out "back in main"

out "linking again"
link r15
sbn, r15, -4, r15, +1
out "jumping to foo again"
sbn, 0, 2, r0, foo
out "back in main again"

out "finish"