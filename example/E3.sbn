### Example 3: function calling
## This will call the foo and then jumps back to main
sbn, 0, -1, r0, start

L foo
out this_is_foo
out jumping_to_main
sbn, 0, -1, r0, r15


L start
out started
out linking_r15
link r15
out jumping_to_foo
sbn, 0, -1, r0, foo
out back_in_main

out linking_again
link r15
out jumping_to_foo_again
sbn, 0, -2, r0, foo
out back_in_main_again

out finish